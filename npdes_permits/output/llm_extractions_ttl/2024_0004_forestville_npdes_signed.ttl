ex:obs_2024_0004_forestville_npdes_signed_0 a s223:ObservationEvent ;
    watr:basedOnSentence "The headworks include a rotary hydroscreen system, a screenings washer, and a metering flume." ;
    watr:hasConfidenceScore "0.95"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Pretreatment ;
    watr:observesEquipment watr:Screen ;
    watr:observesProcess watr:Process-Screening ;
    watr:partOfExtraction ex:extraction_2024_0004_forestville_npdes_signed_20260204 .

ex:obs_2024_0004_forestville_npdes_signed_1 a s223:ObservationEvent ;
    watr:basedOnSentence "The first cell contains two 7.5-horsepower aerators that run continuously, the second cell contains one 5-horsepower aerator that also runs continuously, and the third cell contains a 3-horsepower aerator, set on a timer, to create aerobic and anoxic conditions within the pond." ;
    watr:hasConfidenceScore "0.95"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Aerobic,
        watr:Role-Anoxic,
        watr:Role-Secondary ;
    watr:observesEquipment watr:AerationBasin ;
    watr:observesProcess watr:Process-ActivatedSludge,
        watr:Process-Aeration ;
    watr:partOfExtraction ex:extraction_2024_0004_forestville_npdes_signed_20260204 .

ex:obs_2024_0004_forestville_npdes_signed_2 a s223:ObservationEvent ;
    watr:basedOnSentence "The settling pond (also known as the North Pond) is used for storage during high flows and for filter backwashes." ;
    watr:hasConfidenceScore "0.9"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Secondary,
        watr:Role-Storage ;
    watr:observesEquipment watr:Basin ;
    watr:observesProcess watr:Process-Sedimentation ;
    watr:partOfExtraction ex:extraction_2024_0004_forestville_npdes_signed_20260204 .

ex:obs_2024_0004_forestville_npdes_signed_3 a s223:ObservationEvent ;
    watr:basedOnSentence "Tertiary treatment is achieved in the microfiltration system. The microfiltration system consists of two treatment trains each with a holding tank, strainer, and three banks of 12 microza microfiltration modules (water flows from the outside-in)." ;
    watr:hasConfidenceScore "0.95"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Tertiary ;
    watr:observesEquipment watr:Filter ;
    watr:observesProcess watr:Process-Filtration ;
    watr:partOfExtraction ex:extraction_2024_0004_forestville_npdes_signed_20260204 .

ex:obs_2024_0004_forestville_npdes_signed_4 a s223:ObservationEvent ;
    watr:basedOnSentence "To maintain cleanliness in the filters, the secondary effluent is pre-chlorinated using sodium hypochlorite prior to filtration." ;
    watr:hasConfidenceScore "0.9"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Pretreatment ;
    watr:observesEquipment watr:ChlorinationUnit ;
    watr:observesProcess watr:Process-Chlorination ;
    watr:partOfExtraction ex:extraction_2024_0004_forestville_npdes_signed_20260204 .

ex:obs_2024_0004_forestville_npdes_signed_5 a s223:ObservationEvent ;
    watr:basedOnSentence "A chlorine gas system was replaced with a sodium hypochlorite system in May 2014. Sodium hypochlorite is injected into the 8-inch influent line prior to entering the chlorine contact tank using an injection quill assembly." ;
    watr:hasConfidenceScore "0.95"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Posttreatment ;
    watr:observesEquipment watr:ChlorinationBasin ;
    watr:observesProcess watr:Process-Chlorination,
        watr:Process-Disinfection ;
    watr:partOfExtraction ex:extraction_2024_0004_forestville_npdes_signed_20260204 .

ex:obs_2024_0004_forestville_npdes_signed_6 a s223:ObservationEvent ;
    watr:basedOnSentence "After flowing through the chlorine contact tank, before discharge to the effluent storage pond, the chlorinated effluent is dechlorinated using sodium bisulfite." ;
    watr:hasConfidenceScore "0.9"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Posttreatment ;
    watr:observesEquipment watr:DisinfectionUnit ;
