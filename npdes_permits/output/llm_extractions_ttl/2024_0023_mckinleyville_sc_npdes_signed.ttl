ex:obs_2024_0023_mckinleyville_sc_npdes_signed_7 a s223:ObservationEvent ;
    watr:basedOnSentence "The basin is scheduled to be dredged, dewatered, and dredged solids hauled to an off-site disposal site every 4 to 5 years once the basin has reached capacity" ;
