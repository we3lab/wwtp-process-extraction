ex:obs_2024_0023_mckinleyville_sc_npdes_signed_0 a s223:ObservationEvent ;
    watr:basedOnSentence "The headworks includes a magnetic-type flow meter to measure influent flow, a mechanically cleaned screen, a bypass channel with a bar screen" ;
    watr:hasConfidenceScore "0.95"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:observesEquipment watr:Screen ;
    watr:observesProcess watr:Process-Screening ;
    watr:partOfExtraction ex:extraction_2024_0023_mckinleyville_sc_npdes_signed_20260204 .

ex:obs_2024_0023_mckinleyville_sc_npdes_signed_1 a s223:ObservationEvent ;
    watr:basedOnSentence "Secondary treatment consists of two aeration basins providing a complete mix activated sludge process using extended retention of biological solids" ;
    watr:hasConfidenceScore "0.98"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Secondary ;
    watr:observesEquipment watr:AerationBasin ;
    watr:observesProcess watr:Process-ActivatedSludge,
        watr:Process-Aeration,
        watr:Process-Denitrification,
        watr:Process-Nitrification ;
    watr:partOfExtraction ex:extraction_2024_0023_mckinleyville_sc_npdes_signed_20260204 .

ex:obs_2024_0023_mckinleyville_sc_npdes_signed_10 a s223:ObservationEvent ;
    watr:basedOnSentence "The Permittee also installed a chloramine disinfection system to prevent future violation of disinfection byproduct limitations" ;
    watr:hasConfidenceScore "0.94"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:observesProcess watr:Process-Disinfection ;
    watr:partOfExtraction ex:extraction_2024_0023_mckinleyville_sc_npdes_signed_20260204 .

ex:obs_2024_0023_mckinleyville_sc_npdes_signed_2 a s223:ObservationEvent ;
    watr:basedOnSentence "Two 50-feet diameter, 16-feet side-water-depth secondary clarifiers remove the biomass associated with the secondary treatment process and produce a clarified effluent ready for disinfection and final discharge" ;
    watr:hasConfidenceScore "0.95"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Secondary ;
    watr:observesEquipment watr:SedimentationTank ;
    watr:observesProcess watr:Process-Sedimentation ;
    watr:partOfExtraction ex:extraction_2024_0023_mckinleyville_sc_npdes_signed_20260204 .

ex:obs_2024_0023_mckinleyville_sc_npdes_signed_3 a s223:ObservationEvent ;
    watr:basedOnSentence "The clarifiers include a second center well, the flocculation well, that improves clarifier performance. The flocculation well reduces short-circuiting between the influent feed well and the effluent launder and permits natural flocculation of the biomass contained in the mixed liquor" ;
    watr:hasConfidenceScore "0.92"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:observesEquipment watr:FlocculationBasin ;
    watr:observesProcess watr:Process-Flocculation ;
    watr:partOfExtraction ex:extraction_2024_0023_mckinleyville_sc_npdes_signed_20260204 .

ex:obs_2024_0023_mckinleyville_sc_npdes_signed_4 a s223:ObservationEvent ;
    watr:basedOnSentence "Secondary effluent can either flow by gravity or be pumped to the chlorine contact basins where chlorine solution is used to achieve disinfection" ;
    watr:hasConfidenceScore "0.95"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:observesEquipment watr:ChlorinationBasin ;
    watr:observesProcess watr:Process-Chlorination,
        watr:Process-Disinfection ;
    watr:partOfExtraction ex:extraction_2024_0023_mckinleyville_sc_npdes_signed_20260204 .

ex:obs_2024_0023_mckinleyville_sc_npdes_signed_5 a s223:ObservationEvent ;
    watr:basedOnSentence "chlorine contact basins where chlorine solution is used to achieve disinfection and sulfur dioxide solution is used to dechlorinate" ;
    watr:hasConfidenceScore "0.93"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:observesProcess watr:Process-Dechlorination ;
    watr:partOfExtraction ex:extraction_2024_0023_mckinleyville_sc_npdes_signed_20260204 .

ex:obs_2024_0023_mckinleyville_sc_npdes_signed_6 a s223:ObservationEvent ;
    watr:basedOnSentence "Solids handling consists of pumping WAS from the secondary clarifiers to a biosolids storage basin. The basin has been sized to provide a loading rate of less than 20 pounds volatile suspended solids per 1,000 square feet of basin water surface area" ;
    watr:hasConfidenceScore "0.9"^^xsd:float ;
    watr:hasImplementationStatus "present" ;
    watr:hasRole watr:Role-Anaerobic,
