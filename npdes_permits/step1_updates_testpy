CIWQS_ROOT    = "https://ciwqs.waterboards.ca.gov"
CIWQS_SERVLET = f"{CIWQS_ROOT}/ciwqs/readOnly/CiwqsReportServlet"

def _abs_url(href):
    if not href or href.startswith("http"):
        return href
    if href.startswith("/"):
        return CIWQS_ROOT + href
    return f"{CIWQS_ROOT}/ciwqs/readOnly/{href}"

def _hidden_fields(soup):
    return {i["name"]: i.get("value", "")
            for i in soup.find_all("input", type="hidden") if i.get("name")}

def _select_value(soup, name, visible_text, *, required_label=None):
    sel = soup.find("select", {"name": name})
    if not sel:
        if required_label:
            raise RuntimeError(f"CIWQS form missing <select name={name!r}> ({required_label}).")
        return visible_text
    for opt in sel.find_all("option"):
        if opt.get_text(strip=True) == visible_text:
            return opt.get("value", visible_text)
    if required_label:
        choices = [opt.get_text(strip=True) for opt in sel.find_all("option")]
        raise RuntimeError(
            f"CIWQS {required_label}: no {visible_text!r} in <select name={name!r}>; choices={choices!r}"
        )
    return visible_text


def _retry_get(session, url, max_attempts=4, timeout=120):
    for attempt in range(1, max_attempts + 1):
        try:
            r = session.get(url, timeout=timeout)
            r.raise_for_status()
            return r
        except requests.exceptions.Timeout:
            print(f"[requests] GET timed out (attempt {attempt}/{max_attempts}): {url}")
            if attempt == max_attempts:
                raise
        except requests.exceptions.RequestException:
            raise

def _retry_post(session, url, data, max_attempts=4, timeout=120):
    for attempt in range(1, max_attempts + 1):
        try:
            r = session.post(url, data=data, timeout=timeout)
            r.raise_for_status()
            return r
        except requests.exceptions.Timeout:
            print(f"[requests] POST timed out (attempt {attempt}/{max_attempts}): {url}")
            if attempt == max_attempts:
                raise
        except requests.exceptions.RequestException:
            raise


def _wait_ciwqs_excel_files(directory, timeout=60):
    """Wait for a CIWQS-exported .xls/.xlsx to finish downloading (same as legacy step1)."""
    end_time = time.time() + timeout
    while time.time() < end_time:
        files = glob.glob(os.path.join(directory, "*.xlsx")) + glob.glob(os.path.join(directory, "*.xls"))
        files = [f for f in files if not f.lower().endswith(".crdownload")]
        if files:
            stable = True
            for f in files:
                try:
                    s1 = os.path.getsize(f)
                    time.sleep(0.5)
                    s2 = os.path.getsize(f)
                    if s1 != s2:
                        stable = False
                        break
                except OSError:
                    stable = False
                    break
            if stable:
                return files
        time.sleep(0.5)
    return []


def fetch_facility_data(excel_output_dir, driver):
    """requests for form/Excel; ``driver`` loads drilldown HTML (same URL ×3 on timeout). Returns url map, df, non-clickable."""
    s = requests.Session()
    s.headers["User-Agent"] = (
        "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
        "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    )

    # A: GET initial form page → extract CSRF token + select option values
    print("[requests] Loading CIWQS form…")
    r = _retry_get(s, f"{CIWQS_SERVLET}?inCommand=reset&reportName=RegulatedFacility")
    soup0 = BeautifulSoup(r.text, "html.parser")
    hidden0 = _hidden_fields(soup0)
    csrf = hidden0.get("OWASP_CSRFTOKEN", "")

    related_permit_active = _select_value(
        soup0, "inStatus", "Active", required_label="Related Permit Status"
    )

    def post_filters_and_drilldown_url():
        print("[requests] Submitting filters…")
        post_data = {
            **hidden0,
            "programDrop":   _select_value(soup0, "programDrop",   "NPDES"),
            "typeDrop":      _select_value(soup0, "typeDrop",      "Wastewater Treatment Facility"),
            "wasteTypeDrop": _select_value(soup0, "wasteTypeDrop", "Domestic wastewater"),
            "inStatus":      related_permit_active,
            "enpRepButton":  "",
        }
        resp = _retry_post(s, f"{CIWQS_SERVLET}?OWASP_CSRFTOKEN={csrf}", data=post_data)
        soup = BeautifulSoup(resp.text, "html.parser")
        for a in soup.find_all("a", href=True):
            href = a["href"]
            if "RegulatedFacilityDetail" in href and "drilldown" in href:
                return _abs_url(href)
        raise RuntimeError("Could not find facility drilldown link in CIWQS search response")

    drilldown_url = post_filters_and_drilldown_url()
    print(f"[selenium] Facility list: {drilldown_url}")
    driver.get(CIWQS_ROOT)
    for cookie in s.cookies:
        entry = {"name": cookie.name, "value": cookie.value, "path": getattr(cookie, "path", None) or "/"}
        dom = getattr(cookie, "domain", None) or ""
        if dom:
            entry["domain"] = dom[1:] if dom.startswith(".") else dom
        try:
            driver.add_cookie(entry)
        except Exception:
            try:
                driver.add_cookie({"name": cookie.name, "value": cookie.value, "path": "/"})
            except Exception:
                pass
    driver.set_page_load_timeout(120)
    for attempt in range(1, 4):
        try:
            driver.get(drilldown_url)
            break
        except TimeoutException:
            print(f"[selenium] Page load timed out ({attempt}/3), retrying same URL…")
            if attempt == 3:
                raise
            try:
                driver.execute_script("window.stop();")
            except Exception:
                pass
    for c in driver.get_cookies():
        try:
            s.cookies.set(c["name"], c["value"], domain=c.get("domain"), path=c.get("path", "/"))
        except Exception:
            try:
                s.cookies.set(c["name"], c["value"])
            except Exception:
                pass

    # Detail report: use live DOM (same as last committed Selenium flow), not requests HTML.
    wait = WebDriverWait(driver, 120)
    wait.until(EC.presence_of_element_located((By.CLASS_NAME, "ciwqsReportDataTable")))
    time.sleep(5)
    try:
        Select(driver.find_element(By.NAME, "pagesizeselect")).select_by_visible_text("ALL")
        print("[selenium] Page size set to ALL")
    except Exception:
        print("[selenium] no pagesizeselect found")
    time.sleep(5)
    print("Waiting for table to load with ALL rows...")
    time.sleep(10)
    try:
        wait.until(EC.invisibility_of_element_located((By.CLASS_NAME, "loading")))
        print("Loading indicator disappeared")
    except Exception:
        pass
    table_body = driver.find_element(By.CLASS_NAME, "ciwqsReportDataTable")
    table_rows = table_body.find_elements(By.TAG_NAME, "tr")
    print(f"Final table has {len(table_rows)} rows before export")

    pdfs_dir = os.path.join(excel_output_dir, "pdfs")
    df_deduplicated = pd.DataFrame(columns=["WDID", "Facility Name", "Expiration/Review Date"])
    try:
        export_link = wait.until(
            EC.element_to_be_clickable((By.PARTIAL_LINK_TEXT, "EXPORT THIS REPORT TO EXCEL"))
        )
        export_link.click()
        export_link = wait.until(
            EC.element_to_be_clickable((By.PARTIAL_LINK_TEXT, "EXPORT THIS REPORT TO EXCEL"))
        )
        export_link.click()
        excel_files = _wait_ciwqs_excel_files(pdfs_dir, timeout=60)
        if not excel_files:
            excel_files = _wait_ciwqs_excel_files(excel_output_dir, timeout=30)
        if excel_files:
            excel_file = max(excel_files, key=os.path.getctime)
            try:
                df_raw = pd.read_csv(excel_file, sep="\t", encoding="latin-1")
            except Exception:
                df_raw = pd.read_excel(excel_file)
            df_raw["Expiration/Review Date"] = pd.to_datetime(
                df_raw["Expiration/Review Date"], errors="coerce"
            )
            df_sorted = df_raw.sort_values(
                ["WDID", "Facility Name", "Expiration/Review Date"],
                ascending=[True, True, False],
            )
            df_deduplicated = df_sorted.drop_duplicates(subset=["WDID", "Facility Name"], keep="first")
            print(f"[selenium] Excel: {len(df_raw)} rows → {len(df_deduplicated)} after dedup")
        else:
            print("[selenium] No Excel file detected after export")
    except Exception as e:
        print(f"[selenium] Excel export failed: {e}")

    soup2 = BeautifulSoup(driver.page_source, "html.parser")

    # G: Parse facility table into url_to_facilities
    table = soup2.find("table", class_="ciwqsReportDataTable")
    url_to_facilities = {}
    non_clickable_facilities = []
    if table:
        header_cells = table.find_all("td", class_="ciwqsReportColumnName")
        headers = []
        for cell in header_cells:
            a = cell.find("a")
            headers.append(a.get_text(strip=True) if a else cell.get_text(strip=True))
        col = {h: i for i, h in enumerate(headers)}

        def _cell(cells, name):
            idx = col.get(name)
            return cells[idx].get_text(strip=True) if idx is not None and idx < len(cells) else ""

        for row in table.find_all("tr"):
            cells = row.find_all("td")
            if not cells or row.find("td", class_="ciwqsReportColumnName"):
                continue
            if len(cells) <= max(col.values(), default=-1):
                continue
            order_idx = col.get("Order No.")
            if order_idx is None:
                continue
            order_cell = cells[order_idx]
            order_link = order_cell.find("a")
            # Capture facility detail page URL (needed for Step 2B non-clickable handling)
            fn_idx = col.get("Facility Name")
            facility_url = ""
            if fn_idx is not None and fn_idx < len(cells):
                fn_link = cells[fn_idx].find("a")
                if fn_link and fn_link.get("href"):
                    facility_url = _abs_url(fn_link["href"])
            facility = {
                "agency":        _cell(cells, "Agency"),
                "facility_name": _cell(cells, "Facility Name"),
                "npdes_no":      _cell(cells, "NPDES No."),
                "region":        _cell(cells, "Region"),
                "major_minor":   _cell(cells, "Major/Minor"),
                "order_no":      order_link.get_text(strip=True) if order_link else "",
                "facility_url":  facility_url,
            }
            if order_link and order_link.get("href"):
                url = _abs_url(order_link["href"])
                url_to_facilities.setdefault(url, []).append(facility)
            else:
                non_clickable_facilities.append(facility)

    print(f"[requests] Parsed {sum(len(v) for v in url_to_facilities.values())} facilities "
          f"across {len(url_to_facilities)} unique URLs; "
          f"{len(non_clickable_facilities)} non-clickable")
    return url_to_facilities, df_deduplicated, non_clickable_facilities


def extract_reg_measure_id(href: str):
    if not href:
        return None
    try:
        parsed = urlparse(href)
        query = parse_qs(parsed.query)
        if 'regMeasID' in query and query['regMeasID']:
            return str(query['regMeasID'][0])
    except Exception:
        pass
    match = re.search(r"regMeasID=(\d+)", href, re.IGNORECASE)
    if match:
        return match.group(1)
    return None

